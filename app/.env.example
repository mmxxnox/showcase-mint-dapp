# Which network the app targets: "sepolia" or "local" (a Hardhat node on http://127.0.0.1:8545).
VITE_CHAIN=sepolia

# Addresses printed by `npm run deploy:sepolia` (or deployed_addresses.json in ignition/deployments).
VITE_NFT_ADDRESS=
VITE_TOKEN_ADDRESS=

# Block the contracts were deployed in. Keeps the "My NFTs" log scan short.
VITE_DEPLOY_BLOCK=0

# Optional. Without it the app uses viem's default public Sepolia RPC, which is rate limited.
VITE_SEPOLIA_RPC_URL=

# Optional. Adds WalletConnect (mobile wallets) next to browser-extension wallets.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional. Base URL of chain-indexer-rs (e.g. http://127.0.0.1:3000). Enables the indexer source for "Your NFTs".
VITE_INDEXER_URL=
